{
  "name": "copy-code-reference",
  "displayName": "Copy @file Reference",
  "description": "Copy @file:line-range references to clipboard",
  "version": "0.1.2",
  "publisher": "manooog",
  "repository": {
    "type": "git",
    "url": "https://github.com/35iter-cn/vscode-copy-reference"
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:copyCodeReference.copy",
    "onCommand:copyCodeReference.pasteImage"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copyCodeReference.copy",
        "title": "Copy Code Reference"
      },
      {
        "command": "copyCodeReference.pasteImage",
        "title": "Paste Image Reference"
      }
    ],
    "keybindings": [
      {
        "command": "copyCodeReference.copy",
        "key": "alt+3",
        "when": "editorTextFocus"
      },
      {
        "command": "copyCodeReference.pasteImage",
        "key": "alt+4"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "clean_install": "rm -f copy-code-reference-*.vsix && npm run compile && npx vsce package && cursor --force --install-extension copy-code-reference-*.vsix"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/vscode": "^1.70.0",
    "typescript": "^5.0.0"
  }
}
